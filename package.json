{
  "name": "timo",
  "version": "1.0.0",
  "private": true,
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "eas:init": "npx eas-cli init --non-interactive",
    "eas:build:preview": "npx eas-cli build --platform all --profile preview --non-interactive",
    "eas:build:production": "npx eas-cli build --platform all --profile production --non-interactive",
    "eas:submit": "npx eas-cli submit --platform all --profile production --non-interactive",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo-google-fonts/outfit": "^0.4.3",
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.2.0",
    "expo": "~57.0.20",
    "expo-audio": "~57.0.4",
    "expo-blur": "~57.0.2",
    "expo-constants": "~57.0.8",
    "expo-file-system": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.2",
    "expo-keep-awake": "~57.0.1",
    "expo-notifications": "~57.0.17",
    "expo-status-bar": "~57.0.1",
    "jotai": "^2.20.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  }
}
