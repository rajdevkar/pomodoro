{
  "expo": {
    "name": "Timo",
    "slug": "timo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "owner": "rajdevkar99",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.rajdevkar.timo",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "dev.rajdevkar.timo",
      "permissions": [
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED",
        "SCHEDULE_EXACT_ALARM",
        "POST_NOTIFICATIONS",
        "WAKE_LOCK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#000000",
          "sounds": []
        }
      ],
      "expo-audio",
      [
        "expo-widgets",
        {
          "bundleIdentifier": "dev.rajdevkar.timo.widgets",
          "groupIdentifier": "group.dev.rajdevkar.timo",
          "frequentUpdates": true,
          "enableAndroid": true,
          "widgets": [
            {
              "name": "TimoWidget",
              "displayName": "Timo",
              "description": "Focus timer with play and pause",
              "contentMarginsDisabled": true,
              "supportedFamilies": ["systemSmall", "systemMedium"]
            }
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "b5a5b6cd-07f4-4d53-a98c-041d36416b42"
      }
    }
  }
}
